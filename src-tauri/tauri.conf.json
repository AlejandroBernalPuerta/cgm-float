{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CGM Flotante",
  "version": "0.1.0",
  "identifier": "com.cgmflotante.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CGM Flotante",
        "width": 220,
        "height": 140,
        "minWidth": 160,
        "minHeight": 100,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "center": false
      },
      {
        "label": "settings",
        "title": "Configuración - CGM Flotante",
        "url": "index.html",
        "width": 360,
        "height": 440,
        "resizable": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
